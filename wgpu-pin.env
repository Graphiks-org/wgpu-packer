# Source pinning — consumed by build-target.sh and package.sh.

# X.Y.Z of the wgpu-core / wgpu-hal / naga crates.
# Change when the crates publish a new version: reset PACKER_VERSION to 0.
WGPU_VERSION=30.0.1

# Repackaging counter for the packer.
# +1 for a bug fixed in ffi/, scripts/ or targets/matrix.json.
PACKER_VERSION=0

RUST_TOOLCHAIN=1.93.0
