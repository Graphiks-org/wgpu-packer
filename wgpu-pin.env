# Épinglage des sources — consommé par scripts/sync.sh, build-target.sh et package.sh.

# X.Y.Z des crates wgpu-core / wgpu-hal / naga.
# Change quand wgpu amont publie une nouvelle version : remet PACKER_VERSION à 0.
WGPU_VERSION=30.0.1

# Tag wgpu-native dont on vendore les headers (contrat ABI).
# Change quand le contrat ABI bouge : remet PACKER_VERSION à 0.
WGPU_NATIVE_TAG=v29.0.1.1

# Compteur de republication du packer.
# +1 pour un bug corrigé dans ffi/, scripts/ ou targets/matrix.json.
PACKER_VERSION=0

RUST_TOOLCHAIN=1.93.0
