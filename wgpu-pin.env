# Source pinning — consumed by scripts/sync.sh, build-target.sh and package.sh.

# X.Y.Z of the wgpu-core / wgpu-hal / naga crates.
# Change when upstream wgpu publishes a new version: reset PACKER_VERSION to 0.
WGPU_VERSION=30.0.1

# wgpu-native tag whose headers we vendor (ABI contract).
# Change when the ABI contract moves: reset PACKER_VERSION to 0.
WGPU_NATIVE_TAG=v29.0.1.1

# Repackaging counter for the packer.
# +1 for a bug fixed in ffi/, scripts/ or targets/matrix.json.
PACKER_VERSION=0

RUST_TOOLCHAIN=1.93.0
